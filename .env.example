# Copy to .env and adjust. docker compose reads .env automatically.
# .env is gitignored; never commit real credentials.

# Host port for the web app: http://localhost:8081
FRONTEND_PORT=8081

# Database password, shared by the postgres and backend containers.
# Only takes effect when the database volume is first created.
POSTGRES_PASSWORD=change-me

# IANA zone that defines "today" for reports and receipt numbering.
POS_TIME_ZONE=UTC

# Load the demo catalogue and sales history on first start.
POS_SEED_DEMO_DATA=true

# pgAdmin login (only with --profile tools).
PGADMIN_PASSWORD=change-me
